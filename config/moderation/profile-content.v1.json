{
  "version": "v1",
  "normalization": {
    "confusables": {
      "а": "a",
      "е": "e",
      "о": "o",
      "р": "p",
      "с": "c",
      "х": "x",
      "у": "y",
      "к": "k",
      "м": "m",
      "т": "t",
      "і": "i"
    },
    "leetspeak": {
      "0": "o",
      "1": "i",
      "3": "e",
      "4": "a",
      "5": "s",
      "7": "t",
      "@": "a",
      "$": "s"
    }
  },
  "categories": {
    "abusive": {
      "terms": [
        "дурак", "дурака", "дураки", "дураком", "дурачок",
        "идиот", "идиота", "идиоты", "идиотом",
        "сука", "суки", "суку", "сукой", "сукам", "суками",
        "хуй", "хуя", "блядь", "блять", "мудак", "мудака",
        "чурка", "чурки", "пидор", "уёбок", "ебать", "нюдсы", "порно",
        "fuck", "shit", "ass", "asshole", "moron", "idiot", "bitch", "bastard", "cunt", "nudes", "porn",
        "huy", "durak", "duraka", "duraki", "suka", "suki", "sucka", "blyat", "bliat", "mudak", "nahuy", "nahui", "pidor", "uebok"
      ],
      "phrases": [
        "иди нахуй", "я тебя убью", "убью тебя", "я тебя зарежу", "я тебя покалечу",
        "я тебя прикончу", "kill you", "i will kill you", "hurt you", "send nudes", "пришли нюдсы"
      ],
      "patterns": [
        "(?:^|[^\\p{L}\\p{N}_])идиот(?:а|ы|у|ом|е|ами|ов|ка|ки|ку|кой|ке|ок)(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}_])дурак(?:а|и|у|ом|е|ами|ов)(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}_])сук(?:а|и|у|ой|е|ам|ами)(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}_])(?:durak(?:a|i|u|om|e|ami|ov)?|idiot(?:a|y|u|om|e|ami|ov|ka|ki|ku|koi|ke|ok)?|suk(?:a|i|u|oi|e|am|ami))(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}_])(?:убью|убьём|зарежу|зарежем|покалечу|покалечим|приконч(?:у|им|ишь|ите))(?=$|[^\\p{L}\\p{N}_])"
      ],
      "exceptions": ["не дурак", "не идиот", "роман идиот", "never hurt you"]
    },
    "contact": {
      "terms": [],
      "phrases": [
        "пиши в лс", "пишите в лс", "напиши мне в телеграм", "пишите мне в телеграм",
        "найди меня в телеграм", "мой телеграм", "мой номер", "звони мне",
        "write to me", "contact me", "message me", "dm me", "find me on telegram"
      ],
      "patterns": [
        "(?:https?://|www\\.)\\S+",
        "(?:^|[^\\p{L}\\p{N}_])@[a-z0-9_]{3,}",
        "[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}",
        "(?:^|[^\\p{L}\\p{N}_@])(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,24}(?:[/?:#][^\\s]*)?(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}])\\+\\d(?:[\\s().-]*\\d){6,14}(?=$|[^\\p{L}\\p{N}])",
        "(?:^|[^\\p{L}\\p{N}])375(?:[\\s.-]+\\(?\\d{2}\\)?|\\s*\\(\\d{2}\\))(?:[\\s.-]*\\d){7}(?=$|[^\\p{L}\\p{N}])",
        "(?:^|[^\\p{L}\\p{N}])8(?:[\\s.-]+\\(?\\d{2,3}\\)?|\\s*\\(\\d{2,3}\\))(?:[\\s.-]*\\d){7,8}(?=$|[^\\p{L}\\p{N}])",
        "(?:^|[^\\p{L}\\p{N}])\\(\\d{2,4}\\)\\s*\\d{3}(?:[\\s.-]*\\d{2}){2}(?=$|[^\\p{L}\\p{N}])",
        "(?:^|[^\\p{L}\\p{N}])\\d{2,3}[\\s.-]+\\d{3}(?:[\\s.-]+\\d{2}){2}(?=$|[^\\p{L}\\p{N}])",
        "(?:^|[^\\p{L}\\p{N}])\\d{3}[\\s.-]+\\d{2}[\\s.-]+\\d{2}(?=$|[^\\p{L}\\p{N}])",
        "(?:^|[^\\p{L}\\p{N}])(?:(?:\\+?1[\\s.-]+)?\\d{3}[\\s.-]+\\d{3}[\\s.-]+\\d{4}|(?:\\+?1[\\s.-]*)?\\(\\d{3}\\)[\\s.-]*\\d{3}[\\s.-]+\\d{4})(?=$|[^\\p{L}\\p{N}])",
        "(?:^|[^\\p{L}\\p{N}])\\+?44[\\s.-]+(?:\\(\\d{2,4}\\)|\\d{2,4})[\\s.-]+\\d{3,4}[\\s.-]+\\d{3,4}(?=$|[^\\p{L}\\p{N}])",
        "(?:^|[^\\p{L}\\p{N}])\\+?44[\\s.-]*\\(\\d{2,4}\\)[\\s.-]*\\d{3,4}[\\s.-]+\\d{3,4}(?=$|[^\\p{L}\\p{N}])",
        "(?:^|[^\\p{L}\\p{N}])(?:\\(0\\d{2,4}\\)|0\\d{2,4})[\\s.-]+\\d{3,4}[\\s.-]+\\d{3,4}(?=$|[^\\p{L}\\p{N}])"
      ],
      "obfuscatedPatterns": [
        "(?:https?)\\s*:\\s*(?:/\\s*){2}",
        "(?:^|[^\\p{L}\\p{N}_@])www\\s*\\.\\s*(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\s*\\.\\s*)*[a-z]{2,24}(?:\\s*/\\s*\\S+)?(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}_@])(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\s*\\.\\s*)+[a-z]{2,24}\\s*/\\S+",
        "(?:^|[^\\p{L}\\p{N}_@])(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\s+\\.\\s*)+(?:com|xyz)(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}_])[a-z0-9._%+-]+\\s*@\\s*(?:[a-z0-9-]+\\s*\\.\\s*)+[a-z]{2,24}(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}_])t\\s*\\.\\s*m\\s*e\\s*/\\s*\\S+",
        "(?:^|[^\\p{L}\\p{N}_])w\\s*a\\s*\\.\\s*m\\s*e\\s*/\\s*\\d{6,15}(?=$|[^\\p{L}\\p{N}_])"
      ],
      "exceptions": ["node.js", "readme.md"]
    },
    "advertising": {
      "terms": ["продам", "продаю", "sale"],
      "phrases": [
        "купите сейчас", "закажите сейчас", "приглашаю на работу", "приглашаем на работу",
        "ищем сотрудников", "ищу сотрудников", "ищем менеджера", "откликнись на вакансию", "откликайтесь на вакансию",
        "присоединяйся к нашей команде", "предлагаю заработок",
        "пишите для заказа", "join my team", "join our team", "limited offer", "buy now",
        "order now", "we are hiring", "we're hiring", "apply now"
      ],
      "patterns": [
        "(?:^|[^\\p{L}\\p{N}_])ищ(?:ем|ут)\\s+(?:менеджера|специалиста|сотрудника|сотрудников)(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}_])присоединяй(?:ся|тесь)\\s+к\\s+(?:нашей|моей)\\s+команде(?=$|[^\\p{L}\\p{N}_])",
        "(?:^|[^\\p{L}\\p{N}_])предлага(?:ю|ем|ют)\\s+(?:заработок|подработку|работу)(?=$|[^\\p{L}\\p{N}_])"
      ],
      "exceptions": []
    }
  }
}
